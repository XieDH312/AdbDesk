<Window x:Class="AdbDesk.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新 · AdbDesk" Width="660" Height="650" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner" Icon="Assets/AdbDesk.ico" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="保持 AdbDesk 最新" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,8,0,14" Foreground="{StaticResource MutedBrush}"/>
            <WrapPanel x:Name="PreferencesPanel">
                <CheckBox x:Name="AutoCheck" Content="启动时自动检查" Margin="0,0,20,8" Click="Preferences_Click"/>
                <CheckBox x:Name="PreviewCheck" Content="接收测试版本" Margin="0,0,0,8" Click="Preferences_Click"/>
            </WrapPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,8,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" Text="从 GitHub 获取版本信息，下载后会验证发布签名和文件完整性。"/></ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2">
            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Text="准备检查更新。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
            <TextBlock Text="安装更新会停止投屏和采集，恢复手机代理后重启。个人设置保留。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            <Expander x:Name="DiagnosticPanel" Header="更新诊断" Margin="0,10,0,0">
                <StackPanel>
                    <TextBox x:Name="DiagnosticOutput" Height="100" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="出现更新错误时会在这里显示详情，也可复制最近一次诊断。"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="复制诊断" Click="CopyDiagnostics_Click" Margin="0,0,8,0"/>
                        <Button Content="打开更新目录" Click="OpenUpdateFolder_Click" ToolTip="查看下载缓存、替换日志与保留的旧版备份"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="PageButton" Content="发行页面" Click="Page_Click" Margin="0,0,8,0"/>
            <Button x:Name="CheckButton" Content="检查更新" Click="Check_Click" Margin="0,0,8,0"/>
            <Button x:Name="DownloadButton" Content="下载并更新" IsEnabled="False" Click="Download_Click" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="关闭" Click="Cancel_Click"/>
        </WrapPanel>
    </Grid>
</Window>
