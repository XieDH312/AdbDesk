<Window x:Class="AdbDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdbDesk · Android 设备管理"
        Width="1100" Height="780" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="#EEF3FA" />
        </Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="A" Foreground="White" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AdbDesk" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="连接、投屏与安装，一处完成" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="无线连接" Click="WirelessConnectionButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="RetryButton" Content="重新检测工具" Click="RetryButton_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                    <Button Content="使用帮助" Click="HelpButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="250" MinHeight="205" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="投屏质量" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="QualityComboBox" Width="158" Margin="10,0,18,0" SelectedIndex="1"
                                  ToolTip="最长边像素，重新打开投屏后生效">
                            <ComboBoxItem Content="流畅 · 1024 / 30 帧" Tag="1024,30" />
                            <ComboBoxItem Content="均衡 · 1280 / 30 帧" Tag="1280,30" />
                            <ComboBoxItem Content="清晰 · 1920 / 60 帧" Tag="1920,60" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="AudioCheckBox" Grid.Column="1" Content="传输音频" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="启动所选" Style="{StaticResource PrimaryButtonStyle}" Click="StartSelectedButton_Click" />
                        <Button Content="停止所选" Click="StopSelectedButton_Click" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="选择 APK" Click="ChooseApkButton_Click" Margin="8,0,0,0" />
                        <Button Content="刷新设备" Click="RefreshButton_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" AllowDrop="True"
                    DragOver="PublicDrop_DragOver" Drop="PublicDrop_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,15,18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource PillStyle}" Margin="10,0,0,0">
                                <TextBlock x:Name="DeviceCountText" Text="共 0 · 可用 0 · 待授权 0 · 离线 0 · 投屏 0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border Style="{StaticResource PillStyle}" Background="#EFF6FF" Margin="8,0,0,0">
                                <TextBlock x:Name="SelectedCountText" Text="已选 0 台" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="拖入 APK：安装到已选设备" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DeviceList" ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,0,12,9" Padding="12" CornerRadius="9"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                Background="#FCFDFE" AllowDrop="True"
                                                DragOver="DeviceRow_DragOver" Drop="DeviceRow_Drop">
                                            <Grid ToolTip="{Binding DetailsTooltip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" MinWidth="260" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsReady}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ModelAndAndroid}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SerialAndTransport}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding WirelessBusyText}" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                               ToolTip="{Binding WirelessBusyText}"
                                                               Margin="0,4,12,0" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasWirelessStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="拖入 APK 安装" Foreground="#98A2B3" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <Border Background="{Binding StateBackground}" CornerRadius="10" Padding="9,4"
                                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}"
                                                                       FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Button Content="{Binding MirrorActionText}" IsEnabled="{Binding CanMirrorAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="MirrorButton_Click" />
                                                        <Button Content="{Binding DisconnectActionText}" IsEnabled="{Binding CanDisconnectAction}"
                                                                Visibility="{Binding ShowDisconnectAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="DisconnectButton_Click" Margin="8,0,0,0"
                                                                ToolTip="断开这台设备的当前无线 ADB 连接，不关闭手机无线调试或删除配对记录" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                                Visibility="{Binding ShowWirelessActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="USB 无线连接" Style="{StaticResource CaptionStyle}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Button Content="开启无线" Tag="enable" IsEnabled="{Binding CanWirelessAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="WirelessButton_Click" />
                                                        <Button Content="关闭无线" Tag="disable" IsEnabled="{Binding CanWirelessAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="WirelessButton_Click" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyDevicePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="尚未发现设备" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="连接 USB 并在手机上允许调试授权，设备会自动出现" Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,18,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="安装任务" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="主界面发起的安装 · 双击查看详情" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="InstallCountText" Grid.Column="1" Text="暂无任务" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="InstallList" ItemsSource="{Binding InstallTasks}" BorderThickness="0"
                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,5,12,8" Cursor="Hand" ToolTipService.ShowDuration="30000"
                                              MouseLeftButtonDown="InstallRow_MouseLeftButtonDown">
                                            <Grid.ToolTip>
                                                <ToolTip MaxWidth="640">
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </ToolTip>
                                            </Grid.ToolTip>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Serial}" /><Run Text="  ·  " /><Run Text="{Binding Detail}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="取消" Style="{StaticResource CompactButtonStyle}"
                                                    IsEnabled="{Binding CanCancel}" Click="CancelInstallButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyInstallText" Text="选择 APK 或拖入设备行，安装记录显示在这里。&#10;直接拖入投屏窗口的安装，请查看右侧日志。" Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="投屏日志" Style="{StaticResource SectionTitleStyle}" />
                                <Border Style="{StaticResource PillStyle}" Background="#F0FDF4" Margin="9,0,0,0">
                                    <TextBlock Text="含 scrcpy 原生 APK 拖放输出" Foreground="#15803D" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空" Height="28" Padding="10,0" FontSize="11" Click="ClearLogButton_Click" />
                        </Grid>
                        <ListBox x:Name="MirrorLogList" Grid.Row="1" ItemsSource="{Binding MirrorLogs}" BorderThickness="0"
                                 Background="#F9FBFD" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#EAF1FA" BorderBrush="#D8E4F2" BorderThickness="0,1,0,0" Padding="28,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在准备工具…" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="每 2 秒自动刷新" Style="{StaticResource CaptionStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
