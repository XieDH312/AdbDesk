<Window x:Class="AdbDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdbDesk.App"
        Title="AdbDesk · Android 设备管理"
        Icon="Assets/AdbDesk.ico"
        Width="1100" Height="780" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConnectionHistoryStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="#EEF3FA" />
        </Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ApplicationSurface" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AdbDesk.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AdbDesk" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="连接、投屏与安装，一处完成" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IP" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="QuickConnectIp" Width="140" Height="36" Padding="8,0"
                                 VerticalContentAlignment="Center" MaxLength="15"
                                 InputMethod.IsInputMethodEnabled="False" KeyDown="QuickConnectInput_KeyDown"
                                 AutomationProperties.Name="手机 IP 地址" ToolTip="手机 IPv4 地址，例如 192.168.1.100；这里只填 IP" />
                        <Button x:Name="ConnectionHistoryButton" Content="▾" Width="24" Padding="0" Margin="3,0,0,0"
                                Click="ConnectionHistoryButton_Click" ToolTip="最近成功连接的地址"
                                AutomationProperties.Name="连接历史" />
                        <TextBlock Text=":" Margin="5,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox x:Name="QuickConnectPort" Width="60" Height="36" Padding="8,0" Text="5555"
                                 VerticalContentAlignment="Center" MaxLength="5"
                                 InputMethod.IsInputMethodEnabled="False" KeyDown="QuickConnectInput_KeyDown"
                                 AutomationProperties.Name="ADB 连接端口"
                                 ToolTip="USB 开启无线默认 5555；系统无线调试请填主页显示的连接端口" />
                        <Button x:Name="QuickConnectButton" Content="连接" Click="QuickConnectButton_Click" Margin="8,0,12,0" />
                        <Button Content="无线连接" Click="WirelessConnectionButton_Click" Margin="0,0,8,0" />
                        <Button Content="使用帮助" Click="HelpButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="QuickConnectResult" Visibility="Collapsed" TextWrapping="Wrap"
                               MaxWidth="490" HorizontalAlignment="Left" FontSize="12" Margin="0,6,0,0" />
                    <Button x:Name="RetryButton" Content="重新检测工具" Click="RetryButton_Click"
                            Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="28,10,28,18" Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,9" /><Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabSurface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="#E5EEFF" />
                                        <Setter Property="Foreground" Value="#2563EB" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#DCE8FF" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="设备管理">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="250" MinHeight="205" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="投屏质量" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="QualityComboBox" Width="158" Margin="10,0,18,0" SelectedIndex="2"
                                  ToolTip="分辨率为最长边像素上限，帧率为上限；重新打开投屏后生效">
                            <ComboBoxItem Content="流畅 · 1024 / 30 帧" Tag="1024,30" />
                            <ComboBoxItem Content="均衡 · 1280 / 30 帧" Tag="1280,30" />
                            <ComboBoxItem Content="清晰 · 1920 / 60 帧" Tag="1920,60" />
                            <ComboBoxItem Content="超清 · 2560 / 60 帧" Tag="2560,60" />
                            <ComboBoxItem Content="极清 · 3840 / 60 帧" Tag="3840,60" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="AudioCheckBox" Grid.Column="1" Content="传输音频" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="启动所选" Style="{StaticResource PrimaryButtonStyle}" Click="StartSelectedButton_Click" />
                        <Button Content="停止所选" Click="StopSelectedButton_Click" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="选择 APK" Click="ChooseApkButton_Click" Margin="8,0,0,0" />
                        <Button Content="刷新设备" Click="RefreshButton_Click" Margin="8,0,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="默认显示" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="MirrorFitComboBox" Width="220" Margin="10,0,18,0" SelectedIndex="0"
                                  ToolTip="用于没有独立显示设置的设备。裁剪保持比例，会隐藏边缘内容；可在设备行或投屏顶部单独设置">
                            <ComboBoxItem Content="完整显示 · 保持比例" Tag="complete" />
                            <ComboBoxItem Content="裁剪铺满 · 保持比例" Tag="crop" />
                            <ComboBoxItem Content="上下铺满 · 保持比例" Tag="height" />
                            <ComboBoxItem Content="左右铺满 · 保持比例" Tag="width" />
                        </ComboBox>
                        <CheckBox x:Name="MirrorFullScreenCheckBox" Content="启动时全屏" VerticalAlignment="Center" Margin="0,0,20,0"
                                  ToolTip="在 AdbDesk 所在的显示器全屏打开；F11 或左 Alt+F 切换全屏。修改对新打开的投屏生效" />
                        <TextBlock Text="F11 全屏 · 全屏时移到顶部边缘展开工具栏" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" AllowDrop="True"
                    DragOver="PublicDrop_DragOver" Drop="PublicDrop_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,15,18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource PillStyle}" Margin="10,0,0,0">
                                <TextBlock x:Name="DeviceCountText" Text="共 0 · 可用 0 · 待授权 0 · 离线 0 · 投屏 0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border Style="{StaticResource PillStyle}" Background="#EFF6FF" Margin="8,0,0,0">
                                <TextBlock x:Name="SelectedCountText" Text="已选 0 台" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="拖入 APK：安装到已选设备" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DeviceList" ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,0,12,9" Padding="12" CornerRadius="9"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                Background="#FCFDFE" AllowDrop="True"
                                                DragOver="DeviceRow_DragOver" Drop="DeviceRow_Drop">
                                            <Grid ToolTip="{Binding DetailsTooltip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" MinWidth="260" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsReady}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ModelAndAndroid}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SerialAndTransport}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button ToolTip="{Binding NetworkTooltip}" Click="DeviceWifiIp_Click"
                                                            HorizontalAlignment="Left" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0"
                                                            Visibility="{Binding HasNetworkInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding NetworkText}" MaxWidth="340" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <TextBlock Text="{Binding WirelessBusyText}" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                               ToolTip="{Binding WirelessBusyText}"
                                                               Margin="0,4,12,0" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasWirelessStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="拖入 APK 安装" Foreground="#98A2B3" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <Border Background="{Binding StateBackground}" CornerRadius="10" Padding="9,4"
                                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}"
                                                                       FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Button Content="显示设置" IsEnabled="{Binding CanCaptureAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="MirrorDisplayButton_Click" Margin="0,0,8,0"
                                                                ToolTip="完整显示、上下铺满、左右铺满、自定义裁剪；单独记住这台设备" />
                                                        <Button Content="{Binding CaptureActionText}" IsEnabled="{Binding CanCaptureAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="ScreenshotButton_Click" Margin="0,0,8,0"
                                                                ToolTip="截取这台手机的当前屏幕，无需启动投屏" />
                                                        <Button Content="{Binding MirrorActionText}" IsEnabled="{Binding CanMirrorAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="MirrorButton_Click" />
                                                        <Button Content="{Binding DisconnectActionText}" IsEnabled="{Binding CanDisconnectAction}"
                                                                Visibility="{Binding ShowDisconnectAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="DisconnectButton_Click" Margin="8,0,0,0"
                                                                ToolTip="断开这台设备的当前无线 ADB 连接，不关闭手机无线调试或删除配对记录" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                                Visibility="{Binding ShowWirelessActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="USB 无线连接" Style="{StaticResource CaptionStyle}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Button Content="开启无线" Tag="enable" IsEnabled="{Binding CanWirelessAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="WirelessButton_Click" />
                                                        <Button Content="关闭无线" Tag="disable" IsEnabled="{Binding CanWirelessAction}"
                                                                Style="{StaticResource CompactButtonStyle}" Click="WirelessButton_Click" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyDevicePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="尚未发现设备" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="连接 USB 并在手机上允许调试授权，设备会自动出现" Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" />
                                <Border Style="{StaticResource PillStyle}" Background="#F0FDF4" Margin="9,0,0,0">
                                    <TextBlock Text="投屏 · APK 安装" Foreground="#15803D" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CancelInstallMenuButton" Content="取消安装 ▾" Visibility="Collapsed"
                                        Height="28" Padding="10,0" FontSize="11" Margin="0,0,8,0" Click="CancelInstallMenu_Click" />
                                <Button Content="清空" Height="28" Padding="10,0" FontSize="11" Click="ClearLogButton_Click" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="MirrorLogList" Grid.Row="1" ItemsSource="{Binding MirrorLogs}" BorderThickness="0"
                                 Background="#F9FBFD" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

            </TabItem>
            <TabItem Header="ADB 控制台"><local:ConsolePage x:Name="AdbConsole" /></TabItem>
            <TabItem Header="工具箱"><local:ToolboxPage x:Name="AppToolbox" /></TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#EAF1FA" BorderBrush="#D8E4F2" BorderThickness="0,1,0,0" Padding="28,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在准备工具…" Margin="9,0,12,0" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LocalIpButton" Click="CopyLocalIp_Click" Height="Auto" Padding="4,0" Background="Transparent" BorderThickness="0">
                        <TextBlock x:Name="LocalIpText" FontSize="12" MaxWidth="300" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                    </Button>
                    <Button Content="▾" Click="NetworkMenu_Click" ToolTip="查看并复制所有网卡地址" Height="Auto" Padding="5,0" Background="Transparent" BorderThickness="0" />
                    <TextBlock Text="设备每 2 秒刷新" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
                    <Button x:Name="UpdateButton" Content="检查更新" Click="Update_Click" Margin="12,0,0,0" Height="Auto" Padding="6,1" Background="Transparent" BorderThickness="0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
