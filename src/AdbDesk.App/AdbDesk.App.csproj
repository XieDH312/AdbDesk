<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AdbDesk</AssemblyName>
    <Version>1.0.0-beta.12</Version>
    <VersionCode>10012</VersionCode>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AdbDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VersionCode" Value="$(VersionCode)" />
    <Resource Include="Assets\AdbDesk.ico" />
    <Resource Include="Assets\AdbDesk.png" />
    <ProjectReference Include="..\AdbDesk.Core\AdbDesk.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\network_capture.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\adb-console.md" Link="docs\adb-console.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\updates.md" Link="docs\updates.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\mirror-display.md" Link="docs\mirror-display.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\app-management.md" Link="docs\app-management.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\wireless-discovery.md" Link="docs\wireless-discovery.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\network-capture.md" Link="docs\network-capture.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\mitmproxy-LICENSE.txt" Link="licenses\mitmproxy-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\mitmproxy\mitmdump.exe;..\..\tools\mitmproxy\*.txt" Condition="Exists('..\..\tools\mitmproxy\mitmdump.exe')">
      <Link>tools\mitmproxy\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\licenses\QRCoder-LICENSE.txt">
      <Link>licenses\QRCoder-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\tools\scrcpy\**\*">
      <Link>tools\scrcpy\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="WritePortableInstallationMarker" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)AdbDesk.version.json"
                      Lines="{&quot;versionCode&quot;:$(VersionCode),&quot;versionName&quot;:&quot;$(Version)&quot;}"
                      Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(PublishDir)AdbDesk.installation.json"
                      Lines="{&quot;schemaVersion&quot;:1,&quot;applicationId&quot;:&quot;AdbDesk&quot;,&quot;version&quot;:&quot;$(Version)&quot;}"
                      Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
