<Window x:Class="AdbDesk.App.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图预览" Width="680" Height="760" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#F5F7FC"
        Icon="Assets/AdbDesk.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="DeviceNameText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ImageDetailsText" Foreground="#667085" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#E8EDF5" CornerRadius="10" Padding="10">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Cursor="Hand" ToolTip="点击用系统图片查看器查看原图" MouseLeftButtonUp="PreviewImage_Click" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="查看原图" Padding="15,9" Click="View_Click" />
            <Button Content="复制图片" Padding="15,9" Margin="8,0,0,0" Click="Copy_Click" />
            <Button Content="另存为…" Padding="15,9" Margin="8,0,0,0" Click="Save_Click" IsDefault="True" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="截图尚未保存；复制图片后可直接粘贴。"
                   Foreground="#667085" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
