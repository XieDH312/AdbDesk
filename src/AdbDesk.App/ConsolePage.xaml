<UserControl x:Class="AdbDesk.App.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdbDesk.App"
             FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{StaticResource InkBrush}">
    <UserControl.Resources>
        <Style x:Key="ConsoleInput" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D7E0EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ConsoleSmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="4,3,0,10">
                        <TextBlock Text="命令库" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="LibraryCountText" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="SearchInput" Style="{StaticResource ConsoleInput}" TextChanged="SearchInput_Changed"
                             ToolTip="搜索中文、命令、用途或关键词；多个词以空格分隔" AutomationProperties.Name="搜索命令库" />
                    <TextBlock Text="分类展开 · ☆ 收藏 · 点击填入" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,8,0,8" />
                    <TextBlock x:Name="LibraryEmptyText" Text="没有匹配的命令，请换个关键词。" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,8" />
                </StackPanel>
                <TreeView x:Name="PresetList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="PresetList_Changed">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:ConsolePresetGroup}" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,5" />
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:ConsolePresetItem}">
                            <DockPanel ToolTip="{Binding Tooltip}" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="{Binding Star}" ToolTip="{Binding FavoriteLabel}"
                                        AutomationProperties.Name="{Binding FavoriteLabel}" Click="Favorite_Click"
                                        Width="25" Height="25" Padding="0" Margin="4,0,0,0" FontSize="16"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <ToggleButton x:Name="Expander" Width="15" Height="24" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock x:Name="Arrow" Text="›" FontSize="17" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄" /></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Border x:Name="HeaderBorder" Grid.Column="1" CornerRadius="5" Padding="3,1" Background="Transparent">
                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
                                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#E8F0FF" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Resources>

                </TreeView>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="310">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="TargetCombo" DisplayMemberPath="Label" SelectionChanged="Input_Changed"
                                  AutomationProperties.Name="命令目标设备" ToolTip="设备命令请选择目标；全局命令不使用设备选择" />
                        <Button Grid.Column="1" Content="刷新设备" Margin="8,0,0,0" Click="Refresh_Click" />
                    </Grid>
                    <TextBlock x:Name="DescriptionText" Text="展开左侧分类选择命令，或直接输入 adb 命令。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,4" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="PresetInfoText" Text="手动输入支持更多命令 · Ctrl+Enter 执行" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,0,8" MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <ItemsControl x:Name="ParameterPanel" Visibility="Collapsed" Margin="0,0,-8,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,0,0,4" ToolTip="{Binding Hint}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding BrowseLabel}" Visibility="{Binding BrowseVisibility}"
                                                Height="34" MinWidth="30" Padding="7,0" Margin="5,0,0,0" Click="BrowseParameter_Click"
                                                AutomationProperties.Name="{Binding Label}" />
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConsoleInput}"
                                                 MaxLength="4096" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Label}" />
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="CommandInput" Style="{StaticResource ConsoleInput}" Height="40" FontFamily="Cascadia Mono, Consolas"
                             MaxLength="8192" Text="devices -l" TextChanged="CommandInput_Changed" PreviewKeyDown="CommandInput_KeyDown"
                             ToolTip="输入一条命令，Ctrl+Enter 执行；可省略开头的 adb" AutomationProperties.Name="ADB 命令" />
                    <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="0,7,0,9" MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RunButton" Content="执行" Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click" IsEnabled="False" />
                            <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="7,0,0,0" />
                            <Button x:Name="HistoryButton" Content="历史" Click="History_Click" Margin="7,0,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="TimeoutCombo" Grid.Column="1" Width="102" SelectedIndex="1" ToolTip="最长运行时间">
                            <ComboBoxItem Content="30 秒超时" Tag="30" /><ComboBoxItem Content="2 分钟超时" Tag="120" />
                            <ComboBoxItem Content="10 分钟超时" Tag="600" /><ComboBoxItem Content="持续运行" Tag="0" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="12,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="输出" FontSize="14" FontWeight="SemiBold" />
                            <CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="复制" Style="{StaticResource ConsoleSmallButton}" Click="Copy_Click" />
                            <Button Content="保存" Style="{StaticResource ConsoleSmallButton}" Click="Save_Click" Margin="6,0,0,0" />
                            <Button Content="清空" Style="{StaticResource ConsoleSmallButton}" Click="Clear_Click" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="OutputText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             Background="#142035" Foreground="#DFE7F2" BorderThickness="0" Padding="12" FontFamily="Cascadia Mono, Consolas"
                             FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsUndoEnabled="False"
                             AutomationProperties.Name="命令输出" />
                    <TextBlock x:Name="ResultText" Grid.Row="2" Text="尚未执行命令" Margin="12,8" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
