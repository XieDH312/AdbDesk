<Window x:Class="AdbDesk.App.UsageHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用帮助 · AdbDesk" Width="960" Height="700" MinWidth="620" MinHeight="440"
        Icon="Assets/AdbDesk.ico" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="投屏操作，一眼找到" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="工具栏停靠在投屏外侧；全屏时移到顶部边缘展开。使用快捷键前，请先点击投屏画面。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="投屏操作" Padding="16,8">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="搜索操作" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchInput" Padding="10,7" TextChanged="Search_Changed" ToolTip="搜索熄屏、全屏、返回、音量、复制等操作"/>
                    </DockPanel>
                    <DataGrid x:Name="ShortcutGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource LineBrush}" RowBackground="White" AlternatingRowBackground="#F6F8FC"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}" SelectionMode="Single">
                        <DataGrid.Resources><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,9"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="85"/>
                            <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="145"/>
                            <DataGridTextColumn Header="鼠标 / 快捷键" Binding="{Binding Shortcut}" Width="205"/>
                            <DataGridTemplateColumn Header="说明" Width="*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Note}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#EFF6FF" Padding="12" CornerRadius="8" Margin="0,10,0,0">
                        <TextBlock Text="Alt 指左 Alt；O 是字母，不是数字 0。熄屏只关闭手机实体显示，电脑端仍可操作；手机实体电源键会让屏幕重新亮起。" Foreground="#1D4ED8"/>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="连接、安装与授权" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,16,12,0">
                    <TextBlock x:Name="ConnectionHelpText" FontSize="14" LineHeight="25"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="帮助可保持打开；拖动窗口到旁边，对照操作。" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <Button Content="复制操作列表" Click="Copy_Click" DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
