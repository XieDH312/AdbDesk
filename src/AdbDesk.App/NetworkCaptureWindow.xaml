<Window x:Class="AdbDesk.App.NetworkCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdbDesk.App"
        Title="网络抓包 · AdbDesk" Width="1220" Height="880" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterOwner" Icon="Assets/AdbDesk.ico" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CaptureText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="IsUndoEnabled" Value="False"/>
            <Setter Property="AcceptsReturn" Value="True"/><Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:CaptureJsonNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI"/>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="14">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="网络抓包" FontSize="22" FontWeight="SemiBold" Margin="0,0,14,0"/>
                    <TextBlock x:Name="DeviceText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Content="开始新抓包" Click="Start_Click" Margin="0,0,8,0"/>
                    <Button x:Name="StopButton" Content="停止并恢复" Click="Stop_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RecoveryButton" Content="恢复遗留代理" Click="Recover_Click" Margin="0,0,8,0"/>
                    <Button x:Name="CertificateButton" Content="导出公开 CA" Click="Certificate_Click" Margin="0,0,8,0"/>
                    <Button Content="Debug 配置说明" Click="Help_Click" Margin="0,0,8,0"/>
                    <Button Content="历史文件夹" Click="Folder_Click"/>
                </WrapPanel>
                <Expander x:Name="SettingsExpander" Header="抓包设置与 HTTPS 配置" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid x:Name="SettingsPanel" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Text="抓包引擎" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="EngineInput" Grid.Column="1" Padding="8" AutomationProperties.Name="mitmdump 路径"/>
                            <Button Grid.Column="2" Content="选择…" Click="Browse_Click" Margin="8,0,16,0"/>
                            <TextBlock Grid.Column="3" Text="端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="PortInput" Grid.Column="4" Text="18888" Padding="8" AutomationProperties.Name="本地抓包端口"/>
                        </Grid>
                        <CheckBox x:Name="ProxyCheck" IsChecked="True" Content="自动设置手机全局 HTTP 代理，停止时恢复" Margin="0,10,0,6"/>
                        <TextBlock Text="HTTPS：导出并安装公开 CA，在自己的 Debug App 中配置信任。可能包含其他应用流量；引擎启动不代表 App 已信任证书。" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Expander>
                <Expander Header="连接诊断" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DiagnosticText" Margin="0,6,0,0" FontSize="12" Text="尚未启动抓包。"/>
                        <TextBox x:Name="DiagnosticOutput" Style="{StaticResource CaptureText}" Height="78" Margin="0,6,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="100"/><RowDefinition Height="8"/><RowDefinition Height="3*" MinHeight="140"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="NextPageButton" DockPanel.Dock="Right" Content="下一页" Click="NextPage_Click" Margin="6,0,0,0"/>
                    <Button x:Name="PreviousPageButton" DockPanel.Dock="Right" Content="上一页" Click="PreviousPage_Click" Margin="6,0,0,0"/>
                    <Button x:Name="CurrentHistoryButton" DockPanel.Dock="Right" Content="本次全部记录" Click="CurrentHistory_Click" Margin="6,0,0,0"/>
                    <Button x:Name="HistoryOpenButton" DockPanel.Dock="Right" Content="打开" Click="OpenHistory_Click" Margin="6,0,0,0"/>
                    <Button x:Name="HistoryRefreshButton" DockPanel.Dock="Right" Content="刷新" Click="RefreshHistory_Click" Margin="6,0,0,0"/>
                    <TextBlock Text="历史会话" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="HistoryPicker" DisplayMemberPath="DisplayName" MinWidth="180" ToolTip="停止后可打开历史，不会连接或修改设备" AutomationProperties.Name="历史抓包会话"/>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchInput" Width="180" Padding="7" Margin="0,0,6,0" TextChanged="Search_Changed" ToolTip="关键词：URL、方法、状态或错误" AutomationProperties.Name="请求关键词"/>
                    <TextBlock Text="域名" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="DomainInput" Width="140" Padding="7" Margin="0,0,6,0" TextChanged="Search_Changed" ToolTip="域名：匹配该域名和子域名" AutomationProperties.Name="域名筛选"/>
                    <ComboBox x:Name="MethodFilter" Width="96" Margin="0,0,6,0" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="请求方法">
                        <ComboBoxItem Content="所有方法" Tag=""/><ComboBoxItem Content="GET" Tag="GET"/><ComboBoxItem Content="POST" Tag="POST"/><ComboBoxItem Content="PUT" Tag="PUT"/><ComboBoxItem Content="PATCH" Tag="PATCH"/><ComboBoxItem Content="DELETE" Tag="DELETE"/><ComboBoxItem Content="OPTIONS" Tag="OPTIONS"/>
                    </ComboBox>
                    <ComboBox x:Name="StatusFilter" Width="96" Margin="0,0,6,0" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="状态码筛选">
                        <ComboBoxItem Content="所有状态" Tag=""/><ComboBoxItem Content="2xx" Tag="2xx"/><ComboBoxItem Content="3xx" Tag="3xx"/><ComboBoxItem Content="4xx" Tag="4xx"/><ComboBoxItem Content="5xx" Tag="5xx"/>
                    </ComboBox>
                    <TextBlock Text="类型" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ContentTypeInput" Width="120" Padding="7" Margin="0,0,6,0" TextChanged="Search_Changed" ToolTip="内容类型，例如 json、image" AutomationProperties.Name="内容类型筛选"/>
                    <CheckBox x:Name="FailuresOnly" Content="仅失败" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="SlowOnly" Content="≥1秒" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <Button Content="重置" Click="ResetFilters_Click" Height="32" Margin="8,0,0,0" Padding="10,0"/>
                </WrapPanel>
                <DockPanel Grid.Row="2" Margin="0,0,0,6">
                    <Button x:Name="HarExportButton" DockPanel.Dock="Right" Content="导出会话 HAR" Click="HarExport_Click" Height="30" Padding="10,0" Margin="6,0,0,0"/>
                    <Button x:Name="JsonExportButton" DockPanel.Dock="Right" Content="导出会话 JSON" Click="Export_Click" Height="30" Padding="10,0" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="清空显示" Click="Clear_Click" Height="30" Padding="10,0" Margin="6,0,0,0"/>
                    <TextBlock x:Name="ModeText" Text="实时 · 等待开始" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </DockPanel>
                <DataGrid x:Name="RequestList" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Request_Changed" EnableRowVirtualization="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="85"/>
                        <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="70"/>
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusCode}" Width="60"/>
                        <DataGridTextColumn Header="耗时 ms" Binding="{Binding DurationMs, StringFormat=F0}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="6" Background="{StaticResource LineBrush}"/>
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="复制 URL" Click="CopyUrl_Click" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Content="复制详情" Click="CopyDetails_Click" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Content="复制 cURL" Click="CopyCurl_Click" ToolTip="用于 PowerShell 7；请求正文引用本地历史文件" Height="30" Padding="10,0" Margin="0,0,10,0"/>
                        <ComboBox x:Name="BodyMode" Width="110" Height="30" SelectedIndex="1" SelectionChanged="BodyMode_Changed" Margin="0,0,6,0" AutomationProperties.Name="正文显示方式">
                            <ComboBoxItem Content="原始文本"/><ComboBoxItem Content="JSON 格式化"/><ComboBoxItem Content="JSON 树"/>
                        </ComboBox>
                        <TextBox x:Name="DetailSearchInput" Width="140" Padding="6" AutomationProperties.Name="详情查找" ToolTip="在当前详情页内查找；JSON 树会切换到格式化文本"/>
                        <Button Content="查找下一个" Click="FindDetail_Click" Height="30" Padding="10,0" Margin="6,0,6,0"/>
                        <Button Content="保存正文" Click="SaveBody_Click" Height="30" Padding="10,0" ToolTip="保存当前请求或响应页的原始字节，包含压缩编码"/>
                    </WrapPanel>
                    <TabControl x:Name="DetailTabs" Grid.Row="1">
                        <TabItem Header="概览 / 参数"><TextBox x:Name="DetailsOutput" Style="{StaticResource CaptureText}"/></TabItem>
                        <TabItem Header="请求头"><TextBox x:Name="RequestHeadersOutput" Style="{StaticResource CaptureText}"/></TabItem>
                        <TabItem Header="请求正文"><Grid><TextBox x:Name="RequestBodyOutput" Style="{StaticResource CaptureText}"/><TreeView x:Name="RequestJsonTree" Visibility="Collapsed" Padding="8"/></Grid></TabItem>
                        <TabItem Header="响应头"><TextBox x:Name="ResponseHeadersOutput" Style="{StaticResource CaptureText}"/></TabItem>
                        <TabItem Header="响应正文"><Grid><TextBox x:Name="ResponseBodyOutput" Style="{StaticResource CaptureText}"/><TreeView x:Name="ResponseJsonTree" Visibility="Collapsed" Padding="8"/></Grid></TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="历史按会话保存在电脑；每会话最多 256 MiB，单个正文最多 4 MiB。"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Text="尚未开始。HTTPS 首次使用请展开配置说明。" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</Window>
