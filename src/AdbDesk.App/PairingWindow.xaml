<Window x:Class="AdbDesk.App.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无线连接 Android 设备" Width="760" Height="820" MinWidth="660" MinHeight="680"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="22" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="无线连接设备" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="适用于 Android 11 及以上。手机开启无线调试并连接 Wi-Fi，电脑与手机位于同一局域网。" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <TabControl x:Name="PairingTabs" Grid.Row="1" SelectionChanged="PairingTabs_SelectionChanged">
            <TabItem Header="扫码连接" Padding="16,7">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="手机：开发者选项 → 无线调试 → 使用二维码配对设备" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <TextBlock Text="请使用该页面的扫码入口，不要用微信或普通相机扫描。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" HorizontalAlignment="Center" />
                        <Border Width="280" Height="280" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="点击刷新生成二维码" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="QrExpiryText" Text="二维码两分钟后过期" HorizontalAlignment="Center" Margin="0,8,0,8" />
                        <Button Content="刷新二维码" Click="RefreshQr_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="配对码连接" Padding="16,7">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,16">
                        <TextBlock Text="手机：无线调试 → 使用配对码配对设备。填写弹窗中的信息，并保持弹窗打开。" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="配对地址（手机配对弹窗的 IP 地址和端口）" />
                        <TextBox x:Name="PairingAddress" MinHeight="34" Padding="8,5" Margin="0,5,0,12" ToolTip="例如 192.168.1.100:37123" />
                        <TextBlock Text="六位配对码" />
                        <PasswordBox x:Name="PairingCode" MaxLength="6" MinHeight="34" Padding="8,5" Margin="0,5,0,12" />
                        <TextBlock Text="连接地址（可选，来自手机无线调试主页）" />
                        <TextBox x:Name="OptionalConnectionAddress" MinHeight="34" Padding="8,5" Margin="0,5,0,5" ToolTip="例如 192.168.1.100:40567；端口与配对端口不同" />
                        <TextBlock Text="留空时自动发现。连接端口与配对端口不同，不要固定填写 5555。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                        <Button x:Name="PairCodeButton" Content="配对并连接" Style="{StaticResource PrimaryButtonStyle}" Click="PairCode_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="已配对但未连接？手动填写连接地址" FontWeight="SemiBold" />
                <TextBlock Text="使用手机“无线调试”主页的 IP 地址和端口，例如 192.168.1.100:40567。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ManualConnectionAddress" MinHeight="34" Padding="8,5" />
                    <Button x:Name="ManualConnectButton" Grid.Column="1" Content="连接此地址" Click="ManualConnect_Click" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBox x:Name="ResultText" Grid.Row="3" Margin="0,12,0,0" Height="92" Padding="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}" Background="White" />
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="取消会停止等待；已提交的配对仍可能完成。可在手机无线调试中删除已配对电脑。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消等待" Click="Cancel_Click" IsEnabled="False" />
                <Button Content="关闭" Click="Close_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
